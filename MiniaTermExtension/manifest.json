{
  "manifest_version": 3,
  "name": "MiniaTerm - T&C Auditor",
  "version": "1.1",
  "description": "Automatically detects auth pages, finds Terms & Conditions, and summarizes key consumer rights with AI.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}